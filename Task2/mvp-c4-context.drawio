  <diagram id="c4-context" name="C4 Context">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="C4 Context: целевая архитектура MVP «Медикаменте»" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2100" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="C1: люди, целевая платформа и отдельные внешние программные системы. Внутренние контейнеры раскрываются на следующих уровнях C4." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="2100" height="35" as="geometry"/></mxCell>

        <mxCell id="patient" value="Пациент&lt;br&gt;[Person]&lt;br&gt;Записывается и видит только свои данные" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="reception" value="Ресепшен&lt;br&gt;[Person]&lt;br&gt;Управляет записями и напоминаниями" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="specialist" value="Медицинский специалист&lt;br&gt;[Person]&lt;br&gt;Работает с расписанием и медкартой" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="analyst" value="Бизнес-/BI-/ML-аналитик&lt;br&gt;[Person]&lt;br&gt;Использует обезличенные витрины" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="280" height="110" as="geometry"/></mxCell>

        <mxCell id="platform" value="Платформа «Медикаменте»&lt;br&gt;[Software System]&lt;br&gt;Порталы пациента и ресепшена, CRM, запись,&lt;br&gt;медицинские карты, платежи и уведомления" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#1f6fbd;strokeColor=#174f87;strokeWidth=2;fontColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="300" width="540" height="300" as="geometry"/></mxCell>
        <mxCell id="privacy" value="IAM &amp; Privacy Platform&lt;br&gt;[Software System]&lt;br&gt;OIDC, RBAC/ABAC, MFA, согласия, retention,&lt;br&gt;аудит, SIEM и DLP" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="850" width="520" height="160" as="geometry"/></mxCell>
        <mxCell id="data" value="Data Platform&lt;br&gt;[Software System]&lt;br&gt;Классификация, каталог, lineage, защищённые слои&lt;br&gt;и обезличенные BI/ML-витрины" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1270" y="850" width="520" height="160" as="geometry"/></mxCell>

